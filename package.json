{
  "name": "nuxt-email-renderer",
  "version": "4.0.0",
  "description": "Nuxt email module for rendering HTML emails with Vue components",
  "repository": "mokkapps/nuxt-email-renderer",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./components": {
      "types": "./dist/runtime/components/components.d.ts"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build && npm run client:build",
    "prepack": "pnpm build",
    "client:build": "nuxi generate client",
    "client:dev": "nuxi dev client --port 3300",
    "dev": "npm run play:dev",
    "dev:prepare": "nuxt-module-build --stub && nuxi prepare && nuxi prepare client",
    "docs:dev": "cd docs && pnpm dev",
    "docs:build": "cd docs && pnpm build",
    "prepare": "nuxi prepare client",
    "play:dev": "nuxi dev playground",
    "play:prod": "npm run prepack && nuxi dev playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:compatibility": "node --test compatibility/build-pipeline.test.mjs",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/devtools-kit": "^3.4.4",
    "@nuxt/kit": "^4.6.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "defu": "^6.1.7",
    "html-to-text": "^10.0.1",
    "jiti": "^2.7.0",
    "js-beautify": "^2.0.3",
    "marked": "^18.1.3",
    "shiki": "^4.6.0",
    "sirv": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/devtools-ui-kit": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.3.4",
    "@nuxtjs/i18n": "^10.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.0",
    "nuxt": "^4.6.4",
    "nuxt-email-renderer-devtools": "workspace:*",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-i18n": "^11.4.18",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@nuxtjs/i18n": ">=10.0.0",
    "nuxt": ">=4.1.0",
    "vue-i18n": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxtjs/i18n": {
      "optional": true
    },
    "vue-i18n": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.4"
}
